{
 "uid": "p4-governance-health",
 "title": "Governance health \u2014 Project 4",
 "tags": [
  "project4",
  "governance"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Erasures completed (verified)",
   "description": "Primary audit records only: reruns and repeat requests are never counted.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(erasure_completions_total)",
     "refId": "A",
     "legendFormat": "",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Datasets failing their GE suite",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(ge_checkpoint_pass == 0) or vector(0)",
     "refId": "A",
     "legendFormat": "",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Workspaces drifted",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(terraform_drift) or vector(0)",
     "refId": "A",
     "legendFormat": "",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Gate rejections (PRs, window)",
   "description": "PR runs of the five required gates that concluded failure (gate_metrics_poller.py).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(schema_gate_rejections_total) or vector(0)",
     "refId": "A",
     "legendFormat": "",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "GE checkpoint pass / fail per dataset (1 = pass)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ge_checkpoint_pass",
     "refId": "A",
     "legendFormat": "{{dataset}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "custom": {
      "lineInterpolation": "stepAfter",
      "lineWidth": 2
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Quarantine: rows held and rows added by the last run",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "quarantine_rows_total",
     "refId": "A",
     "legendFormat": "{{dataset}} held",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "quarantine_rows_last_run",
     "refId": "B",
     "legendFormat": "{{dataset}} last run",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "custom": {
      "lineInterpolation": "stepAfter"
     }
    },
    "overrides": []
   },
   "description": "Held = quarantine_rows_total. It steps up when a checkpoint quarantines rows and down when an erasure deletes an erased subject's quarantined copy."
  },
  {
   "id": 7,
   "type": "bargauge",
   "title": "Gate rejections by gate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (gate) (schema_gate_rejections_total)",
     "refId": "A",
     "legendFormat": "{{gate}}",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Gate latency p50, full checks only",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (gate) (gate_latency_seconds{quantile=\"0.5\"})",
     "refId": "A",
     "legendFormat": "{{gate}}",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Terraform drift by workspace",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (workspace) (terraform_drift)",
     "refId": "A",
     "legendFormat": "",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "clean",
         "color": "green"
        },
        "1": {
         "text": "DRIFT",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Attributes changed outside Terraform (live)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (workspace, resource, attribute) (terraform_drift_attribute)",
     "refId": "A",
     "legendFormat": "",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      }
     }
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "description": "Quarantine rate, checkpoint pass/fail, gate rejections and latency, erasure completions, drift. Every panel binds to a metric pushed by this repo."
}
