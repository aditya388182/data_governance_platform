{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.governance.payments",
  "doc": "Governed contract for subject payments.public.transactions-value (same shape Project 1 produces). Versions are this file's git history on main; the schema gate replays that history.",
  "fields": [
    {
      "name": "transaction_id",
      "type": "string",
      "doc": "UUID4; value format enforced by the GE suite (Day 2)"
    },
    {
      "name": "merchant_id",
      "type": "string"
    },
    {
      "name": "customer_id",
      "type": "string",
      "doc": "Data-subject key for erasure (Day 4/5)"
    },
    {
      "name": "amount_minor",
      "type": "long",
      "doc": "Minor units; >= 0 enforced by the GE suite"
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO-4217 alpha-3"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "AUTHORIZED",
          "CAPTURED",
          "SETTLED",
          "REFUNDED",
          "REVERSED"
        ]
      }
    },
    {
      "name": "event_ts",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "updated_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "risk_score",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Fraud-model score; nullable with default so every older record stays readable"
    },
    {
      "name": "receipt_email",
      "type": [
        "null",
        "string"
      ],
      "default": null
    }
  ]
}